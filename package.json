{
  "name": "bri-db",
  "version": "2.0.0",
  "description": "BRI - Bigdata Repository of Intelligence - A simple, intuitive database framework",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/codemeasandwich/BRI"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./src/client/index.js",
    "./engine": "./src/engine/index.js",
    "./engine/middleware.js": "./src/engine/middleware.js",
    "./remote": "./src/remote/index.js",
    "./storage": "./src/storage/index.js",
    "./utils/jss": "./src/utils/jss/index.js",
    "./utils/diff": "./src/utils/diff/index.js",
    "./utils/schema": "./src/utils/schema/index.js",
    "./workers": "./src/workers/index-worker-host.js",
    "./workers/index-worker-host.js": "./src/workers/index-worker-host.js",
    "./workers/vector-worker-env.js": "./src/workers/vector-worker-env.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns='/scale\\.test\\.js$'",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --testPathIgnorePatterns='/scale\\.test\\.js$'",
    "test:scale": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern='/scale\\.test\\.js$'",
    "jsdoc-check": "node scripts/jsdoc-check.js",
    "release": "bash scripts/publish.sh",
    "prepare": "git config core.hooksPath .hooks"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "ws": "^8.20.0"
  }
}
